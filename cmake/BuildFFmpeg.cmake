include("${config}")
file(MAKE_DIRECTORY "${cache}")
file(LOCK "${cache}/build.lock" GUARD PROCESS TIMEOUT 1800)
set(complete TRUE)
foreach(output IN LISTS outputs)
    if(NOT EXISTS "${output}")
        set(complete FALSE)
    endif()
endforeach()
if(complete AND EXISTS "${cache}/complete")
    return()
endif()
file(MAKE_DIRECTORY "${cache}/build")
execute_process(COMMAND ${command} WORKING_DIRECTORY "${cache}/build"
    OUTPUT_FILE "${cache}/build.log" ERROR_FILE "${cache}/build.log" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    file(READ "${cache}/build.log" output)
    string(LENGTH "${output}" length)
    if(length GREATER 6000)
        math(EXPR start "${length} - 6000")
        string(SUBSTRING "${output}" ${start} -1 output)
    endif()
    if(EXISTS "${cache}/build/ffbuild/config.log")
        file(READ "${cache}/build/ffbuild/config.log" config_log)
        string(LENGTH "${config_log}" length)
        if(length GREATER 4000)
            math(EXPR start "${length} - 4000")
            string(SUBSTRING "${config_log}" ${start} -1 config_log)
        endif()
        string(APPEND output "\nTail of ffbuild/config.log:\n${config_log}")
    endif()
    message(FATAL_ERROR "FFmpeg build failed (${result}). Log: ${cache}/build.log\n${output}")
endif()
foreach(output IN LISTS outputs)
    if(NOT EXISTS "${output}")
        message(FATAL_ERROR "FFmpeg build did not produce ${output}. Log: ${cache}/build.log")
    endif()
endforeach()
file(WRITE "${cache}/complete" "Built successfully\n")
